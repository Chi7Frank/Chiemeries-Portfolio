        <div class="pop-up fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-[2000] w-[90%] max-w-[960px] max-h-[85vh] max-md:max-h-[90vh] overflow-y-auto grid grid-cols-1 md:grid-cols-2 gap-6 p-12 max-md:py-7 max-md:px-5 bg-white rounded-[20px] shadow-[0_30px_70px_rgba(0,0,0,0.35)] none web-dev" data-popup>
