                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="project flex flex-col p-6 bg-white border border-teal-pale-2 rounded-[14px]">
                <img src="images/webdev.png" alt="Campus Cent" class="project-img w-full h-[180px] object-cover rounded-[10px] mb-4 bg-teal-pale-2" />
                <h3 class="project-title title-3 text-[1.15rem] font-semibold text-brand-black mb-2 font-heading">Campus Cent</h3>
                <p class="project-desc text-[0.9rem] leading-[1.55] text-teal-dark-2 mb-5">
                    Campus Cent is an Advanced LifeStyle Budgeter Application made exclusively for students in Nigerian university communities. It makes use of well trained models to check student fiscal capacity against predicted market prices and helps students make the right financial decision.
                </p>
                <a href="https://github.com/Chi7Frank" target="_blank" rel="noopener" class="project-link mt-auto self-start text-[0.9rem] font-semibold text-teal-primary no-underline transition-colors duration-200 hover:text-teal-dark">Check it Out &rarr;</a>
            </div>

            <div class="project flex flex-col p-6 bg-white border border-teal-pale-2 rounded-[14px]">
                <img src="images/webdev.png" alt="Portfolio Web App" class="project-img w-full h-[180px] object-cover rounded-[10px] mb-4 bg-teal-pale-2" />
                <h3 class="project-title title-3 text-[1.15rem] font-semibold text-brand-black mb-2 font-heading">Personal Portfolio</h3>
                <p class="project-desc text-[0.9rem] leading-[1.55] text-teal-dark-2 mb-5">
                    A responsive, component-structured portfolio application refactored with Tailwind CSS, featuring an interactive certificate carousel, popup project showcase, and dynamic contact workflows.
                </p>
                <a href="#hero-section" class="project-link mt-auto self-start text-[0.9rem] font-semibold text-teal-primary no-underline transition-colors duration-200 hover:text-teal-dark">Check it Out &rarr;</a>
            </div>
        </div>

        <!-- Graphic Design Popup -->
        <div class="pop-up fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-[2000] w-[90%] max-w-[960px] max-h-[85vh] max-md:max-h-[90vh] overflow-y-auto grid grid-cols-1 md:grid-cols-2 gap-6 p-12 max-md:py-7 max-md:px-5 bg-white rounded-[20px] shadow-[0_30px_70px_rgba(0,0,0,0.35)] none graphics-design" data-popup>
            <button class="popup-close sticky top-0 ml-auto w-10 h-10 rounded-full border-none flex items-center justify-center bg-teal-pale-2 text-teal-dark-2 text-[1.1rem] cursor-pointer col-span-full justify-self-end transition-[background-color,color,transform] duration-200 hover:bg-teal-primary hover:text-white hover:rotate-90 z-10" data-popup-close aria-label="Close project details">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="project flex flex-col p-6 bg-white border border-teal-pale-2 rounded-[14px]">
                <img src="images/graphics.png" alt="Brand Identity" class="project-img w-full h-[180px] object-cover rounded-[10px] mb-4 bg-teal-pale-2" />
                <h3 class="project-title title-3 text-[1.15rem] font-semibold text-brand-black mb-2 font-heading">Brand Identity &amp; Systems</h3>
                <p class="project-desc text-[0.9rem] leading-[1.55] text-teal-dark-2 mb-5">
                    Comprehensive visual brand guidelines, typography hierarchies, logo design systems, and color palettes developed for student-led initiatives and tech community groups.
                </p>
                <a href="https://github.com/Chi7Frank" target="_blank" rel="noopener" class="project-link mt-auto self-start text-[0.9rem] font-semibold text-teal-primary no-underline transition-colors duration-200 hover:text-teal-dark">Check it Out &rarr;</a>
            </div>
        </div>

        <!-- Research Articles Popup -->
        <div class="pop-up fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-[2000] w-[90%] max-w-[960px] max-h-[85vh] max-md:max-h-[90vh] overflow-y-auto grid grid-cols-1 md:grid-cols-2 gap-6 p-12 max-md:py-7 max-md:px-5 bg-white rounded-[20px] shadow-[0_30px_70px_rgba(0,0,0,0.35)] none research-articles" data-popup>
            <button class="popup-close sticky top-0 ml-auto w-10 h-10 rounded-full border-none flex items-center justify-center bg-teal-pale-2 text-teal-dark-2 text-[1.1rem] cursor-pointer col-span-full justify-self-end transition-[background-color,color,transform] duration-200 hover:bg-teal-primary hover:text-white hover:rotate-90 z-10" data-popup-close aria-label="Close project details">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="project flex flex-col p-6 bg-white border border-teal-pale-2 rounded-[14px]">
                <img src="images/articles.png" alt="Research Article" class="project-img w-full h-[180px] object-cover rounded-[10px] mb-4 bg-teal-pale-2" />
                <h3 class="project-title title-3 text-[1.15rem] font-semibold text-brand-black mb-2 font-heading">Defensive Cybersecurity in Cloud Microservices</h3>
                <p class="project-desc text-[0.9rem] leading-[1.55] text-teal-dark-2 mb-5">
                    Investigative paper examining proactive anomaly detection, zero-trust architectures, and cryptographic defenses in distributed containerized environments.
                </p>
                <a href="https://substack.com/@alphamockingbird" target="_blank" rel="noopener" class="project-link mt-auto self-start text-[0.9rem] font-semibold text-teal-primary no-underline transition-colors duration-200 hover:text-teal-dark">Read on Substack &rarr;</a>
            </div>
        </div>
    </aside>

    <!-- Footer -->
    <footer class="flex max-md:flex-col items-center justify-between gap-3 max-md:text-center py-8 px-8 max-md:p-6 max-w-[1200px] mx-auto bg-teal-dark text-teal-pale-2 text-[0.85rem]">
