<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chiemerie's Portfolio</title>
    <meta name="description" content="Portfolio of Chiemerie Obinwa, Computer Science student and Front-End Web Developer, refactored with Tailwind CSS." />
    <meta property="og:title" content="Chiemerie's Portfolio" />
    <meta property="og:description" content="Portfolio of Chiemerie Obinwa, Computer Science student and Front-End Web Developer, refactored with Tailwind CSS." />
    
    <!-- TAILWIND CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              'teal-dark-2': '#002D2D',
              'teal-dark': '#0f3d3e',
              'teal-primary': '#008080',
              'teal-light': '#4fb0a5',
              'teal-pale': '#69B4B4',
              'teal-pale-2': '#C3E1E1',
              'brand-black': '#0d1210',
              'gold-accent': '#d4a24c',
              'gold-light': '#e8c17d',
            },
            fontFamily: {
              heading: ['"Space Grotesk"', 'sans-serif'],
              body: ['Inter', 'sans-serif'],
            }
          }
        }
      }
    </script>
    
    <!-- ICON CDN -->
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simple-icons-font@13/font/simple-icons.min.css" />
    
    <!-- GOOGLE FONTS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    
    <!-- CUSTOM STYLESHEET FOR NON-REFACTORABLE RULES -->
    <link rel="stylesheet" href="couldnot.css" />
    
    <!-- SCRIPTS -->
    <script src="scripts/carousel.js" defer></script>
    <script src="scripts/pop-up.js" defer></script>
    <script src="scripts/header.js" defer></script>
</head>

<body class="font-body relative bg-white text-brand-black m-0 p-0 antialiased">
    <!-- Header / Navbar -->
    <header class="header bg-teal-pale-2 border-b border-teal-pale shadow-[0_1px_8px_rgba(15,61,62,0.06)] transition-[box-shadow] duration-200">
        <nav class="navbar flex items-center justify-between h-[72px] px-8 max-md:px-5 max-w-[1200px] mx-auto">
            <div class="logo">
                <a href="/" class="flex items-center">
                    <img src="images/C-logo-dark.png" alt="Chiemerie's Logo" class="h-10 w-auto block rounded-full" />
                </a>
            </div>
                
            <ul class="nav-links flex items-center gap-9 list-none max-md:hidden">
                <li>
                    <a href="#hero-section" class="relative no-underline text-teal-dark-2 font-medium text-[0.95rem] tracking-[0.02em] py-2 px-[0.1rem] transition-colors duration-200 hover:text-teal-pale active">
                        About Me
                    </a>
                </li>
                <li>
                    <a href="#projects-section" class="relative no-underline text-teal-dark-2 font-medium text-[0.95rem] tracking-[0.02em] py-2 px-[0.1rem] transition-colors duration-200 hover:text-teal-pale">
                        Projects
                    </a>
                </li>
                <li>
                    <a href="#skills-section" class="relative no-underline text-teal-dark-2 font-medium text-[0.95rem] tracking-[0.02em] py-2 px-[0.1rem] transition-colors duration-200 hover:text-teal-pale">
                        Skillsets
                    </a>
                </li>
                <li>
                    <a href="#certification-sections" class="relative no-underline text-teal-dark-2 font-medium text-[0.95rem] tracking-[0.02em] py-2 px-[0.1rem] transition-colors duration-200 hover:text-teal-pale">
                        Certifications
                    </a>
                </li>
                <li>
                    <a href="#story-section" class="relative no-underline text-teal-dark-2 font-medium text-[0.95rem] tracking-[0.02em] py-2 px-[0.1rem] transition-colors duration-200 hover:text-teal-pale">
                        My Story
                    </a>
                </li>
                <li>
                    <a href="#contact-section" class="relative no-underline text-teal-dark-2 font-medium text-[0.95rem] tracking-[0.02em] py-2 px-[0.1rem] transition-colors duration-200 hover:text-teal-pale">
                        Contact Me
                    </a>
                </li>
            </ul>
                
            <button class="hamburger hidden max-md:flex max-md:items-center max-md:justify-center max-md:w-10 max-md:h-10 max-md:border-none max-md:bg-transparent max-md:text-teal-dark-2 max-md:text-xl max-md:cursor-pointer" id="hamburger-btn" aria-label="Toggle navigation menu" aria-expanded="false">
                <i class="fa-solid fa-bars"></i>
            </button>
        </nav>
    </header>

    <main class="main-body">
        <!-- Hero Section -->
        <section id="hero-section" class="hero-section max-w-[1200px] mx-auto py-12 px-8 max-md:py-10 max-md:px-5 bg-teal-pale-2">
            <div class="hero-grid grid grid-cols-1 md:grid-cols-[1fr_1.2fr] items-center gap-x-12 gap-y-4 max-md:gap-y-8 mt-8 max-md:mt-4 max-md:text-center">
                <div class="hero-img-block flex justify-center max-md:order-1">
                    <img src="images/MyPic~2.png" alt="My Picture" class="hero-img w-full max-w-[380px] max-md:max-w-[240px] aspect-square object-cover rounded-[20%] border-[3px] border-teal-dark shadow-[0_12px_32px_rgba(0,128,128,0.18)]" />
                </div>
                <div class="hero-txt-block max-md:order-2">
                    <h2 class="section-title text-base font-semibold tracking-[0.15em] uppercase text-teal-primary mb-6 font-heading">About Me</h2>
                    <p class="hero-intro text-[1.35rem] max-md:text-[1.05rem] leading-[1.7] text-brand-black text-justify">
                        Hi, I am <span class="my-name text-teal-primary font-bold">Chiemerie Obinwa</span>, 
                        a Computer Science student at the Federal University of 
                        Technology, Owerri (FUTO), Nigeria. I am a front end 
                        developer and tech enthusiast with growing passion for 
                        System Architecture and Designs, Defensive Security, 
                        Cloud Engineering and AI Engineering.
                    </p>
                </div>
            </div>
        </section>

        <!-- Projects Section -->
        <section id="projects-section" class="projects-section max-w-[1200px] mx-auto py-20 px-8 max-md:py-12 max-md:px-5">
            <h2 class="section-title text-base font-semibold tracking-[0.15em] uppercase text-teal-primary mb-10 font-heading">My Projects</h2>

            <div class="projects-card-container grid grid-cols-1 md:grid-cols-3 gap-8 max-md:gap-6">
                <!-- Web Dev Card -->
                <div id="web-dev" class="project-theme-card bg-white border border-teal-pale-2 rounded-[14px] p-8 max-md:p-6 cursor-pointer flex flex-col transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1.5 hover:border-teal-light hover:shadow-[0_12px_28px_rgba(0,128,128,0.16)] active:-translate-y-0.5 active:shadow-[0_6px_14px_rgba(0,128,128,0.22)] active:border-teal-primary">
                    <img src="images/webdev.png" alt="Web Design Project" class="project-card-img w-full h-[180px] object-cover rounded-lg mb-6 bg-teal-pale-2" />
                    <h3 class="project-theme title-3 text-xl font-semibold text-brand-black mb-3 font-heading">Web-Development</h3>
                    <p class="project-theme-desc text-[0.95rem] text-teal-dark-2 leading-normal mb-5 max-md:text-justify">
                        As a Front-End Web Developer, my roles in these projects includes but are not limited to
                    </p>
                    <ul class="project-theme-list list-none flex flex-col gap-2.5 mt-auto">
                        <li class="flex items-center gap-2.5 text-[0.9rem] text-brand-black"><i class="fa-regular fa-circle-check text-teal-primary text-[0.95rem]"></i>Design Translation</li>
                        <li class="flex items-center gap-2.5 text-[0.9rem] text-brand-black"><i class="fa-regular fa-circle-check text-teal-primary text-[0.95rem]"></i>Ensuring Responsiveness</li>
                        <li class="flex items-center gap-2.5 text-[0.9rem] text-brand-black"><i class="fa-regular fa-circle-check text-teal-primary text-[0.95rem]"></i>Performance Optimization</li>
                        <li class="flex items-center gap-2.5 text-[0.9rem] text-brand-black"><i class="fa-regular fa-circle-check text-teal-primary text-[0.95rem]"></i>API Integration</li>
                        <li class="flex items-center gap-2.5 text-[0.9rem] text-brand-black"><i class="fa-regular fa-circle-check text-teal-primary text-[0.95rem]"></i>Testing and Debugging</li>
                        <li class="flex items-center gap-2.5 text-[0.9rem] text-brand-black mt-3"><i class="fa-regular fa-lightbulb text-gold-light text-[0.95rem]"></i>Tap Card to view more</li>
                    </ul>
                </div>

                <!-- Graphic Design Card -->
                <div id="graphics-design" class="project-theme-card bg-white border border-teal-pale-2 rounded-[14px] p-8 max-md:p-6 cursor-pointer flex flex-col transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1.5 hover:border-teal-light hover:shadow-[0_12px_28px_rgba(0,128,128,0.16)] active:-translate-y-0.5 active:shadow-[0_6px_14px_rgba(0,128,128,0.22)] active:border-teal-primary">
                    <img src="images/graphics.png" alt="Graphic Design Project" class="project-card-img w-full h-[180px] object-cover rounded-lg mb-6 bg-teal-pale-2" />
                    <h3 class="project-theme title-3 text-xl font-semibold text-brand-black mb-3 font-heading">Graphic Design</h3>
                    <p class="project-theme-desc text-[0.95rem] text-teal-dark-2 leading-normal mb-5 max-md:text-justify">
                        As a Graphic Designer, my roles in these projects includes but are not limited to
                    </p>
                    <ul class="project-theme-list list-none flex flex-col gap-2.5 mt-auto">
                        <li class="flex items-center gap-2.5 text-[0.9rem] text-brand-black"><i class="fa-regular fa-circle-check text-teal-primary text-[0.95rem]"></i>Conceptualization</li>
                        <li class="flex items-center gap-2.5 text-[0.9rem] text-brand-black"><i class="fa-regular fa-circle-check text-teal-primary text-[0.95rem]"></i>Colour Palette Creation</li>
                        <li class="flex items-center gap-2.5 text-[0.9rem] text-brand-black"><i class="fa-regular fa-circle-check text-teal-primary text-[0.95rem]"></i>Communication through Designs</li>
                        <li class="flex items-center gap-2.5 text-[0.9rem] text-brand-black"><i class="fa-regular fa-circle-check text-teal-primary text-[0.95rem]"></i>Brand Identity Creation</li>
                        <li class="flex items-center gap-2.5 text-[0.9rem] text-brand-black"><i class="fa-regular fa-circle-check text-teal-primary text-[0.95rem]"></i>Social Media</li>
                        <li class="flex items-center gap-2.5 text-[0.9rem] text-brand-black mt-3"><i class="fa-regular fa-lightbulb text-gold-light text-[0.95rem]"></i>Tap Card to view more</li>
                    </ul>
                </div>

                <!-- Research Articles Card -->
                <div id="research-articles" class="project-theme-card bg-white border border-teal-pale-2 rounded-[14px] p-8 max-md:p-6 cursor-pointer flex flex-col transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1.5 hover:border-teal-light hover:shadow-[0_12px_28px_rgba(0,128,128,0.16)] active:-translate-y-0.5 active:shadow-[0_6px_14px_rgba(0,128,128,0.22)] active:border-teal-primary">
                    <img src="images/articles.png" alt="Research Article Projects" class="project-card-img w-full h-[180px] object-cover rounded-lg mb-6 bg-teal-pale-2" />
                    <h3 class="project-theme title-3 text-xl font-semibold text-brand-black mb-3 font-heading">Research Articles</h3>
                    <p class="project-theme-desc text-[0.95rem] text-teal-dark-2 leading-normal mb-5 max-md:text-justify">
                        As a Computer Scholar, my roles in these projects includes but are not limited to
                    </p>
                    <ul class="project-theme-list list-none flex flex-col gap-2.5 mt-auto">
                        <li class="flex items-center gap-2.5 text-[0.9rem] text-brand-black"><i class="fa-regular fa-circle-check text-teal-primary text-[0.95rem]"></i>Intense Investigation</li>
                        <li class="flex items-center gap-2.5 text-[0.9rem] text-brand-black"><i class="fa-regular fa-circle-check text-teal-primary text-[0.95rem]"></i>Fact Findings</li>
                        <li class="flex items-center gap-2.5 text-[0.9rem] text-brand-black"><i class="fa-regular fa-circle-check text-teal-primary text-[0.95rem]"></i>Citing Sources</li>
                        <li class="flex items-center gap-2.5 text-[0.9rem] text-brand-black"><i class="fa-regular fa-circle-check text-teal-primary text-[0.95rem]"></i>Structuring Drafts</li>
                        <li class="flex items-center gap-2.5 text-[0.9rem] text-brand-black"><i class="fa-regular fa-circle-check text-teal-primary text-[0.95rem]"></i>Addressing Feedback</li>
                        <li class="flex items-center gap-2.5 text-[0.9rem] text-brand-black mt-3"><i class="fa-regular fa-lightbulb text-gold-light text-[0.95rem]"></i>Tap Card to view more</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Skills Section -->
        <section id="skills-section" class="skills-section max-w-[1200px] mx-auto py-20 px-8 max-md:py-12 max-md:px-5">
            <h2 class="section-title text-base font-semibold tracking-[0.15em] uppercase text-teal-primary mb-10 font-heading">My Skillset</h2>
            <div class="skills-container grid grid-cols-1 md:grid-cols-2 gap-12 max-md:gap-10">

                <div class="technical-skills flex flex-col">
                    <h3 class="skill-title title-3 text-[1.3rem] font-semibold text-brand-black mb-6 font-heading">Technical Skills</h3>

                    <h4 class="skill-group-label text-[0.85rem] font-semibold tracking-[0.08em] uppercase text-teal-dark mt-0 mb-3 font-heading">Languages</h4>
                    <ul class="language-skills flex flex-wrap gap-4 max-md:gap-3">
                        <li class="flex-object list-none flex flex-col items-center justify-center gap-2.5 w-[110px] min-h-[120px] p-5 max-md:p-3.5 bg-white border border-teal-pale-2 rounded-xl text-center transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1 hover:border-teal-light hover:shadow-[0_10px_22px_rgba(0,128,128,0.14)] max-md:flex-[1_1_calc(50%-0.5rem)] max-md:w-auto max-md:min-h-[90px]">
                            <i class="devicon-html5-plain colored text-[2rem] max-md:text-[1.6rem]"></i>
                            <span class="text-[0.8rem] max-md:text-[0.72rem] font-medium text-brand-black">HTML</span>
                        </li>
                        <li class="flex-object list-none flex flex-col items-center justify-center gap-2.5 w-[110px] min-h-[120px] p-5 max-md:p-3.5 bg-white border border-teal-pale-2 rounded-xl text-center transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1 hover:border-teal-light hover:shadow-[0_10px_22px_rgba(0,128,128,0.14)] max-md:flex-[1_1_calc(50%-0.5rem)] max-md:w-auto max-md:min-h-[90px]">
                            <i class="devicon-css3-plain colored text-[2rem] max-md:text-[1.6rem]"></i>
                            <span class="text-[0.8rem] max-md:text-[0.72rem] font-medium text-brand-black">CSS</span>
                        </li>
                        <li class="flex-object list-none flex flex-col items-center justify-center gap-2.5 w-[110px] min-h-[120px] p-5 max-md:p-3.5 bg-white border border-teal-pale-2 rounded-xl text-center transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1 hover:border-teal-light hover:shadow-[0_10px_22px_rgba(0,128,128,0.14)] max-md:flex-[1_1_calc(50%-0.5rem)] max-md:w-auto max-md:min-h-[90px]">
                            <i class="devicon-javascript-plain colored text-[2rem] max-md:text-[1.6rem]"></i>
                            <span class="text-[0.8rem] max-md:text-[0.72rem] font-medium text-brand-black">JS</span>
                        </li>
                        <li class="flex-object list-none flex flex-col items-center justify-center gap-2.5 w-[110px] min-h-[120px] p-5 max-md:p-3.5 bg-white border border-teal-pale-2 rounded-xl text-center transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1 hover:border-teal-light hover:shadow-[0_10px_22px_rgba(0,128,128,0.14)] max-md:flex-[1_1_calc(50%-0.5rem)] max-md:w-auto max-md:min-h-[90px]">
                            <i class="devicon-python-plain colored text-[2rem] max-md:text-[1.6rem]"></i>
                            <span class="text-[0.8rem] max-md:text-[0.72rem] font-medium text-brand-black">PY</span>
                        </li>
                    </ul>

                    <h4 class="skill-group-label text-[0.85rem] font-semibold tracking-[0.08em] uppercase text-teal-dark mt-6 mb-3 font-heading">Collaboration Tools</h4>
                    <ul class="collab-skills flex flex-wrap gap-4 max-md:gap-3">
                        <li class="flex-object list-none flex flex-col items-center justify-center gap-2.5 w-[110px] min-h-[120px] p-5 max-md:p-3.5 bg-white border border-teal-pale-2 rounded-xl text-center transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1 hover:border-teal-light hover:shadow-[0_10px_22px_rgba(0,128,128,0.14)] max-md:flex-[1_1_calc(50%-0.5rem)] max-md:w-auto max-md:min-h-[90px]">
                            <i class="devicon-git-plain colored text-[2rem] max-md:text-[1.6rem]"></i>
                            <span class="text-[0.8rem] max-md:text-[0.72rem] font-medium text-brand-black">GIT</span>
                        </li>
                        <li class="flex-object list-none flex flex-col items-center justify-center gap-2.5 w-[110px] min-h-[120px] p-5 max-md:p-3.5 bg-white border border-teal-pale-2 rounded-xl text-center transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1 hover:border-teal-light hover:shadow-[0_10px_22px_rgba(0,128,128,0.14)] max-md:flex-[1_1_calc(50%-0.5rem)] max-md:w-auto max-md:min-h-[90px]">
                            <i class="devicon-github-original text-[2rem] max-md:text-[1.6rem]"></i>
                            <span class="text-[0.8rem] max-md:text-[0.72rem] font-medium text-brand-black">GITHUB</span>
                        </li>
                    </ul>
                </div>

                <div class="soft-skills flex flex-col">
                    <h3 class="skill-title title-3 text-[1.3rem] font-semibold text-brand-black mb-6 font-heading">Soft Skills</h3>
                    <h4 class="skill-group-label text-[0.85rem] font-semibold tracking-[0.08em] uppercase text-teal-dark mt-0 mb-3 font-heading">Communication</h4>
                    <ul class="communication-skills flex flex-wrap gap-4 max-md:gap-3">
                        <li class="flex-object list-none flex flex-col items-center justify-center gap-2.5 w-[110px] min-h-[120px] p-5 max-md:p-3.5 bg-white border border-teal-pale-2 rounded-xl text-center transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1 hover:border-teal-light hover:shadow-[0_10px_22px_rgba(0,128,128,0.14)] max-md:flex-[1_1_calc(50%-0.5rem)] max-md:w-auto max-md:min-h-[90px]">
                            <i class="fa-solid fa-people-group text-teal-primary text-[2rem] max-md:text-[1.6rem]"></i>
                            <span class="text-[0.8rem] max-md:text-[0.72rem] font-medium text-brand-black">Collaboration</span>
                        </li>
                        <li class="flex-object list-none flex flex-col items-center justify-center gap-2.5 w-[110px] min-h-[120px] p-5 max-md:p-3.5 bg-white border border-teal-pale-2 rounded-xl text-center transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1 hover:border-teal-light hover:shadow-[0_10px_22px_rgba(0,128,128,0.14)] max-md:flex-[1_1_calc(50%-0.5rem)] max-md:w-auto max-md:min-h-[90px]">
                            <i class="fa-solid fa-users-gear text-teal-primary text-[2rem] max-md:text-[1.6rem]"></i>
                            <span class="text-[0.8rem] max-md:text-[0.72rem] font-medium text-brand-black">Team Management</span> 
                        </li>
                        <li class="flex-object list-none flex flex-col items-center justify-center gap-2.5 w-[110px] min-h-[120px] p-5 max-md:p-3.5 bg-white border border-teal-pale-2 rounded-xl text-center transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1 hover:border-teal-light hover:shadow-[0_10px_22px_rgba(0,128,128,0.14)] max-md:flex-[1_1_calc(50%-0.5rem)] max-md:w-auto max-md:min-h-[90px]">
                            <i class="fa-solid fa-person-chalkboard text-teal-primary text-[2rem] max-md:text-[1.6rem]"></i>
                            <span class="text-[0.8rem] max-md:text-[0.72rem] font-medium text-brand-black">Public Speaking</span>
                        </li>
                        <li class="flex-object list-none flex flex-col items-center justify-center gap-2.5 w-[110px] min-h-[120px] p-5 max-md:p-3.5 bg-white border border-teal-pale-2 rounded-xl text-center transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1 hover:border-teal-light hover:shadow-[0_10px_22px_rgba(0,128,128,0.14)] max-md:flex-[1_1_calc(50%-0.5rem)] max-md:w-auto max-md:min-h-[90px]">
                            <i class="fa-solid fa-chalkboard-user text-teal-primary text-[2rem] max-md:text-[1.6rem]"></i>
                            <span class="text-[0.8rem] max-md:text-[0.72rem] font-medium text-brand-black">Subject Mentoring</span>
                        </li>
                    </ul>
                    
                    <h4 class="skill-group-label text-[0.85rem] font-semibold tracking-[0.08em] uppercase text-teal-dark mt-6 mb-3 font-heading">Problem Solving</h4>
                    <ul class="prob-solving-skills flex flex-wrap gap-4 max-md:gap-3">
                        <li class="flex-object list-none flex flex-col items-center justify-center gap-2.5 w-[110px] min-h-[120px] p-5 max-md:p-3.5 bg-white border border-teal-pale-2 rounded-xl text-center transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-1 hover:border-teal-light hover:shadow-[0_10px_22px_rgba(0,128,128,0.14)] max-md:flex-[1_1_calc(50%-0.5rem)] max-md:w-auto max-md:min-h-[90px]">
                            <i class="fa-solid fa-magnifying-glass-chart text-teal-primary text-[2rem] max-md:text-[1.6rem]"></i>
                            <span class="text-[0.8rem] max-md:text-[0.72rem] font-medium text-brand-black">Research</span>
                        </li>
